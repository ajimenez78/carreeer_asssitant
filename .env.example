# Optional local settings. Keep an existing .env; do not overwrite your API key.
CAREER_APP_NAME="Career assistant"

# Required for login: a stable random secret of at least 32 characters.
# Generate via: uv run --project backend --locked python -c 'import secrets; print(secrets.token_urlsafe(48))'
# CAREER_SESSION_SECRET=
CAREER_SESSION_SECURE=false
# JSON array. Writes require an exact Origin match, including curl/API clients.
CAREER_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:3000","http://localhost:3000"]
# Set secure=true and the actual HTTPS origin for hosted operation in Part 11.

# Local Compose database only. Never use this example password for hosted data.
CAREER_POSTGRES_PASSWORD=local-development-only

# Optional PostgreSQL overrides. Defaults use the local Compose database above.
# DATABASE_URL=postgresql+psycopg://career:local-development-only@127.0.0.1:5432/career
# DATABASE_DIRECT_URL=postgresql+psycopg://user:password@direct-neon-host/database?sslmode=verify-full
# DATABASE_DIRECT_URL is used for migrations; the runtime may use a pooled URL.

# Originals stay outside the application image; extracted/reviewed text is in SQL.
CAREER_DOCUMENT_BACKEND=local
CAREER_DOCUMENT_DIRECTORY=.data/documents
# In Part 11, use a preconfigured private Neon bucket and Neon-issued credentials.
# CAREER_DOCUMENT_BACKEND=neon
# CAREER_NEON_STORAGE_ENDPOINT=https://branch-storage-endpoint
# CAREER_NEON_STORAGE_REGION=eu-central-1
# CAREER_NEON_STORAGE_BUCKET=private-documents
# CAREER_NEON_STORAGE_ACCESS_KEY=
# CAREER_NEON_STORAGE_SECRET_KEY=

# Backend-only key. Explicit AI commands/facts/clarification calls need it.
# OPENAI_API_KEY=
CAREER_AI_MODEL=gpt-6-luna
CAREER_AI_REASONING_EFFORT=low
CAREER_AI_TIMEOUT_SECONDS=60
CAREER_AI_MAX_INPUT_TOKENS=20000
CAREER_AI_MAX_OUTPUT_TOKENS=2000
# The client always uses https://api.openai.com/v1; no base-URL override.
