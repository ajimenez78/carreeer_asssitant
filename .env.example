# Local settings load .env, then .env.local. Keep existing secrets.
CAREER_APP_NAME="Career assistant"

# Required for login: a stable random secret of at least 32 characters.
# Generate via: uv run --project backend --locked python -c 'import secrets; print(secrets.token_urlsafe(48))'
# CAREER_SESSION_SECRET=
CAREER_SESSION_SECURE=false
# JSON array. Writes require an exact Origin match, including curl/API clients.
CAREER_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:3000","http://localhost:3000"]
# Render startup requires secure=true and uses RENDER_EXTERNAL_URL as the origin
# unless CAREER_ALLOWED_ORIGINS is explicitly set.

# Local Compose database only. Never use this example password for hosted data.
CAREER_POSTGRES_PASSWORD=local-development-only

# Optional PostgreSQL overrides. Defaults use the local Compose database above.
# DATABASE_URL=postgresql+psycopg://career:local-development-only@127.0.0.1:5432/career
# DATABASE_DIRECT_URL=postgresql+psycopg://user:password@dpg-ID.frankfurt-postgres.render.com/database?sslmode=verify-full&sslrootcert=system
# DATABASE_URL_UNPOOLED is also accepted as a direct-connection alias.
# DATABASE_DIRECT_URL is used for migrations; the runtime may use a pooled URL.

# Originals stay outside the application image; extracted/reviewed text is in SQL.
CAREER_DOCUMENT_BACKEND=local
CAREER_DOCUMENT_DIRECTORY=.data/documents
# In deployment, use a private R2 bucket separate from the backup bucket.
# CAREER_DOCUMENT_BACKEND=s3
# CAREER_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# CAREER_S3_REGION=auto
# CAREER_S3_BUCKET=career-assistant-documents
# CAREER_S3_ACCESS_KEY=
# CAREER_S3_SECRET_KEY=
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# are accepted as equivalent backend-only aliases.

# Backend-only key. Explicit AI commands/facts/clarification calls need it.
# OPENAI_API_KEY=
CAREER_AI_MODEL=gpt-6-luna
CAREER_AI_REASONING_EFFORT=low
CAREER_AI_TIMEOUT_SECONDS=60
CAREER_AI_MAX_INPUT_TOKENS=20000
CAREER_AI_MAX_OUTPUT_TOKENS=2000
# The client always uses https://api.openai.com/v1; no base-URL override.

# Independent private backup storage (e.g. Cloudflare R2 Standard free allowance).
# Use only on the external backup runner, not on the public web service.
# CAREER_BACKUP_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# CAREER_BACKUP_REGION=auto
# CAREER_BACKUP_BUCKET=career-assistant-backups
# CAREER_BACKUP_ACCESS_KEY=
# CAREER_BACKUP_SECRET_KEY=
# CAREER_BACKUP_PREFIX=career-backups/
# Restore uses a distinct EMPTY database and separate document target.
# CAREER_RESTORE_DATABASE_URL=postgresql://user:password@host/empty-db?sslmode=verify-full&sslrootcert=system
